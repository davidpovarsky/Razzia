{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": [
      "../../../packages/socket/node_modules/@types",
      "../../../extensions/node_modules/@types",
      "../../../node_modules/@types"
    ]
  },
  "include": ["./**/*.ts"]
}
