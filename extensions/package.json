{
  "name": "@razzia/extensions",
  "version": "4.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "site:dev": "pnpm --dir ../packages/web exec node --experimental-strip-types node_modules/vite/bin/vite.js --config ../../extensions/site.vite.config.ts --host 127.0.0.1",
    "site:build": "pnpm --dir ../packages/web exec node --experimental-strip-types node_modules/vite/bin/vite.js build --config ../../extensions/site.vite.config.ts",
    "site:preview": "pnpm --dir ../packages/web exec node --experimental-strip-types node_modules/vite/bin/vite.js preview --config ../../extensions/site.vite.config.ts --host 127.0.0.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./gameplay": "./src/gameplay/index.ts",
    "./media": "./src/media/index.ts",
    "./presentation": "./src/presentation/index.ts",
    "./presentation/platform-controls": "./src/presentation/platform-controls.tsx",
    "./telephony": "./src/telephony/index.ts",
    "./testkit": "./src/testkit/index.ts",
    "./editor": "./src/editor/index.ts",
    "./locales": "./src/locales/index.ts",
    "./server": "./src/server/index.ts",
    "./site": "./src/site/index.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@lottiefiles/dotlottie-react": "0.17.1",
    "@razzia/common": "workspace:*",
    "hono": "catalog:",
    "http-status-codes": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "react-i18next": "^17.0.16",
    "i18next": "catalog:",
    "@fontsource-variable/rubik": "^5.3.0"
  },
  "peerDependencies": {
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "esbuild": "0.28.2",
    "@hono/node-server": "^2.1.4",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "socket.io-client": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "^5.0.3",
    "vite": "^8.3.4",
    "tailwindcss": "^4.3.3",
    "@playwright/test": "^1.64.0"
  }
}
